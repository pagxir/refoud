<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/config_header">
        <EditTextPreference
            app:key="host"
            app:title="@string/host_title" />
        <EditTextPreference
            app:key="port"
            app:title="@string/port_title" />
        <EditTextPreference
            app:key="dns"
            app:title="@string/dns_title" />
    </PreferenceCategory>

    <SwitchPreferenceCompat
	    app:key="switch"
	    app:title="Turn VPN on/off"/>

    <Preference
        app:key="feedback"
        app:title="Send feedback"
        app:summary="Report technical issues or suggest new features"/>

</PreferenceScreen>
