<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Server">
        <EditTextPreference
            app:key="host"
            app:title="Host"
            app:summary="Server address"
            app:defaultValue=""
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="port"
            app:title="Port"
            app:summary="Server port"
            app:defaultValue=""
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Network">
        <EditTextPreference
            app:key="dns"
            app:title="DNS Server"
            app:summary="Custom DNS (optional)"
            app:defaultValue=""
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Connection">
        <SwitchPreferenceCompat
            app:key="switch"
            app:title="VPN Status"
            app:summary="Turn VPN on or off"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

</PreferenceScreen>